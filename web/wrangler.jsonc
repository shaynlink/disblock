{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disblock",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes such as /bots/:id fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only /api goes through the worker; static files are served directly.
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // The Fly.io app running crates/server.
    "API_ORIGIN": "https://disblock-api.fly.dev",
  },
  "observability": { "enabled": true },
}
