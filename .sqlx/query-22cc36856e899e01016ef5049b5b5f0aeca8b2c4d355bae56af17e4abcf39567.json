  "query": "SELECT e.id, e.trigger, e.success, e.error, e.duration_ms, e.created_at\n         FROM executions e JOIN bots b ON b.id = e.bot_id\n         WHERE e.bot_id = $1 AND b.owner_id = $2\n         ORDER BY e.created_at DESC\n         LIMIT $3",
