DATABASE_URL=postgres://disblock:disblock@localhost:5433/disblock
# Owner role, used only by `disblock-server migrate`. In production the app's
# DATABASE_URL uses a role that can read and write rows but not alter tables.
MIGRATION_DATABASE_URL=postgres://disblock:disblock@localhost:5433/disblock
# Public URL of the app (the Cloudflare domain in production).
PUBLIC_URL=http://localhost:5173
# Discord application used for "Login with Discord" (https://discord.com/developers/applications).
# Add {PUBLIC_URL}/api/auth/callback to its OAuth2 redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
PORT=8080
RUST_LOG=info,disblock_server=debug
# Optional error tracking. Leave SENTRY_DSN empty for local-only telemetry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
# Web app: put VITE_SENTRY_DSN in web/.env.local (scripts/configure-secrets.sh development).
ORIGIN_SECRET=
